# Your OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# The OpenRouter model id JEV runs on (copy it from the model's page on openrouter.ai)
JEV_MODEL=

# Optional
# JEV_TEMPERATURE=0.9
# HOST=127.0.0.1
# PORT=5000

# Recording: searches and generated pages are always logged. By default they go
# to the console as JSON lines. Start with --capture (or JEV_CAPTURE=1) to store
# them in Postgres instead. Railway sets DATABASE_URL when you add a Postgres
# service and reference it.
# JEV_CAPTURE=1
# DATABASE_URL=postgresql://user:pass@host:5432/db

# Set to 1 to click around offline with canned responses (no API key needed)
# JEV_MOCK=1
